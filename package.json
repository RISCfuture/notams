{
  "name": "notam-service",
  "version": "1.0.0",
  "description": "FAA NMS NOTAM ingestion and API service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "migrate": "node dist/scripts/migrate.js",
    "prune": "node dist/scripts/prune-notams.js",
    "lint": "pnpm run lint:eslint && pnpm run lint:oxlint && pnpm run lint:knip",
    "lint:eslint": "node scripts/lint.cjs",
    "lint:oxlint": "oxlint -c oxlintrc.json src tests",
    "lint:knip": "knip",
    "lint:fix": "node scripts/lint.cjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm run type-check:app && pnpm run type-check:tests",
    "type-check:app": "tsc -p tsconfig.app.json --noEmit",
    "type-check:tests": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "notam",
    "aviation",
    "faa",
    "nms"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^10.60.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.9.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "saxes": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "knip": "^6.20.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=26.4.0"
  },
  "packageManager": "pnpm@11.5.1"
}
